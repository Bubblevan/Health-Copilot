@@ -0,0 +1,39 @@
+import json
+
+import pytest
+
+from agents_memory.propmem import _answer_from_json_content
+
+
+def test_propmem_answer_parser_reads_complete_json():
+    content = '{"reasoning":"ok","answer":"600 followers"}'
+
+    assert _answer_from_json_content(content) == "600 followers"
+
+
+def test_propmem_answer_parser_recovers_missing_outer_brace():
+    content = '{\n  "reasoning": "The evidence is direct.",\n  "answer": "600 followers"'
+
+    assert _answer_from_json_content(content) == "600 followers"
+
+
+def test_propmem_answer_parser_rejects_incomplete_answer_string():
+    with pytest.raises(json.JSONDecodeError):
+        _answer_from_json_content('{"reasoning":"ok","answer":"600 followers')
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        '{"reasoning":"ok"}',
+        '{"reasoning":"ok","answer":17}',
+        '{"reasoning":"ok","answer":null}',
+        '{"reasoning":"ok","answer":"new answer","extra":"changed semantics"',
+        '{"reasoning":"ok","answer":"new answer"} arbitrary trailing content',
+        '{"reasoning":"ok","answer":"safe","answer":"changed semantics"}',
+        '{"reasoning":"ok","answer":"safe","extra":"changed semantics"}',
+    ],
+)
+def test_propmem_answer_parser_rejects_unapproved_partial_or_trailing_forms(content):
+    with pytest.raises((json.JSONDecodeError, ValueError)):
+        _answer_from_json_content(content)
