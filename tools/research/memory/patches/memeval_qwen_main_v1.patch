+def test_network_guard_blocks_any_non_loopback_request_without_sending(tmp_path):
+    ledger = tmp_path / "calls.jsonl"
+    provider.configure_call_ledger(ledger)
+    transport = httpx.MockTransport(
+        lambda request: pytest.fail(f"network transport must not receive {request.url.host}")
+    )
+    client = provider._telemetry_client("reader_answer", "FullContext", "q2", transport)
+    with pytest.raises(RuntimeError, match="blocked a non-loopback"):
+        client.post("https://api.openai.com/v1/chat/completions", json={"model": "qwen"})
+    assert json.loads(ledger.read_text(encoding="utf-8"))["success"] is False
+    client.close()
