@@ -0,0 +1,305 @@
+"""Local, pinned Qwen3 embedding adapter used by every MEM-1 system."""
+
+from __future__ import annotations
+
+import gc
+import hashlib
+import json
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, Literal
+
+import numpy as np
+
+from agents_memory.healthcopilot_provider import current_call_context, record_call
+
+MODEL_ID = "Qwen/Qwen3-Embedding-0.6B"
+MODEL_REVISION = "97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3"
+WEIGHTS_SHA256 = "0437e45c94563b09e13cb7a64478fc406947a93cb34a7e05870fc8dcd48e23fd"
+DIMENSIONS = 1024
+BATCH_SIZE = 8
+MAX_LENGTH = 8192
+MAX_BATCH_TOKENS = 8192
+DEFAULT_DEVICE = "cuda:0"
+DEFAULT_DTYPE = "float16"
+QUERY_INSTRUCTION = (
+    "Given a conversation-history question, retrieve memory passages that "
+    "provide evidence needed to answer the question."
+)
+
+
+def _file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as file:
+        for block in iter(lambda: file.read(8 * 1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _tree_sha256(root: Path) -> str:
+    digest = hashlib.sha256()
+    for path in sorted(
+        item for item in root.rglob("*") if item.is_file() and ".hfd" not in item.parts
+    ):
+        relative = path.relative_to(root).as_posix().encode()
+        digest.update(relative + b"\0" + bytes.fromhex(_file_sha256(path)) + b"\n")
+    return digest.hexdigest()
+
+
+@dataclass(frozen=True)
+class EmbeddingArtifact:
+    repo: str
+    revision: str
+    model_sha256: str
+    weights_sha256: str
+    dimensions: int
+    normalized: bool
+    query_instruction: str
+    document_instruction: str
+    batch_size: int
+    max_batch_tokens: int
+    device: str
+    dtype: str
+    torch_version: str
+    cuda_version: str
+    device_name: str
+    max_length: int
+    truncation: bool
+
+
+class LocalEmbeddingRuntime:
+    def __init__(self, model_path: str | Path, device: str, dtype: str):
+        path = Path(model_path).expanduser().resolve()
+        required = ("model.safetensors", "config.json", "tokenizer.json", "tokenizer_config.json")
+        missing = [name for name in required if not (path / name).is_file()]
+        if missing:
+            raise RuntimeError(f"Local Qwen3 embedding files are missing from {path}: {missing}")
+        weights_hash = _file_sha256(path / "model.safetensors")
+        if weights_hash != WEIGHTS_SHA256:
+            raise RuntimeError("Local Qwen3 embedding weights do not match the frozen revision")
+
+        metadata_path = path / ".hfd" / "repo_metadata.json"
+        if metadata_path.exists():
+            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+            if metadata.get("id") != MODEL_ID or metadata.get("sha") != MODEL_REVISION:
+                raise RuntimeError(
+                    "Local Qwen3 embedding repository revision is not frozen revision"
+                )
+
+        import torch
+        import torch.nn.functional as functional
+        from transformers import AutoModel, AutoTokenizer
+        from transformers.utils import logging as transformers_logging
+
+        self._torch = torch
+        self._functional = functional
+        self._path = path
+        transformers_logging.disable_progress_bar()
+        transformers_logging.set_verbosity_error()
+        if not device.startswith("cuda") or not torch.cuda.is_available():
+            raise RuntimeError("Frozen MEM-1 embedding runtime requires an available CUDA device")
+        if device == "cuda":
+            device = "cuda:0"
+        if dtype != "float16":
+            raise RuntimeError("Frozen MEM-1 embedding dtype must be float16")
+        self.device = device
+        self.dtype = dtype
+        self.torch_dtype = torch.float16
+        self.batch_size = BATCH_SIZE
+        self.max_batch_tokens = MAX_BATCH_TOKENS
+        self.max_length = MAX_LENGTH
+        self.tokenizer = AutoTokenizer.from_pretrained(
+            str(path), local_files_only=True, padding_side="left", trust_remote_code=False
+        )
+        self.tokenizer.padding_side = "left"
+        self.model = AutoModel.from_pretrained(
+            str(path), local_files_only=True, trust_remote_code=False, dtype=self.torch_dtype
+        ).to(self.device)
+        self.model.eval()
+        dimension = int(self.model.config.hidden_size)
+        if dimension != DIMENSIONS:
+            raise RuntimeError(f"Unexpected Qwen3 embedding dimension: {dimension}")
+        self.artifact = EmbeddingArtifact(
+            repo=MODEL_ID,
+            revision=MODEL_REVISION,
+            model_sha256=_tree_sha256(path),
+            weights_sha256=weights_hash,
+            dimensions=dimension,
+            normalized=True,
+            query_instruction=QUERY_INSTRUCTION,
+            document_instruction="",
+            batch_size=BATCH_SIZE,
+            max_batch_tokens=MAX_BATCH_TOKENS,
+            device=self.device,
+            dtype=self.dtype,
+            torch_version=torch.__version__,
+            cuda_version=str(torch.version.cuda),
+            device_name=torch.cuda.get_device_name(self.device),
+            max_length=MAX_LENGTH,
+            truncation=True,
+        )
+
+    def count_tokens(self, texts: list[str]) -> int:
+        return sum(
+            len(self.tokenizer(text, add_special_tokens=True, truncation=False)["input_ids"])
+            for text in texts
+        )
+
+    def _batch_slices(self, token_counts: list[int]) -> list[tuple[int, int]]:
+        slices = []
+        start = 0
+        token_total = 0
+        for index, token_count in enumerate(token_counts):
+            if index > start and (
+                index - start >= self.batch_size
+                or token_total + token_count > self.max_batch_tokens
+            ):
+                slices.append((start, index))
+                start = index
+                token_total = 0
+            token_total += min(token_count, self.max_length)
+        if start < len(token_counts):
+            slices.append((start, len(token_counts)))
+        return slices
+
+    def encode(
+        self,
+        texts: list[str],
+        input_type: Literal["query", "document"],
+    ) -> tuple[list[list[float]], int, bool, float]:
+        started = time.perf_counter()
+        instruction = f"Instruct: {QUERY_INSTRUCTION}\nQuery:" if input_type == "query" else ""
+        prepared = [f"{instruction}{text}" if instruction else text for text in texts]
+        full_token_counts = [
+            len(self.tokenizer(text, add_special_tokens=True, truncation=False)["input_ids"])
+            for text in prepared
+        ]
+        truncated = any(count > self.max_length for count in full_token_counts)
+        outputs: list[list[float]] = []
+        retained_tokens = 0
+        try:
+            for start, end in self._batch_slices(full_token_counts):
+                batch = prepared[start:end]
+                tokens = self.tokenizer(
+                    batch,
+                    padding=True,
+                    truncation=True,
+                    max_length=self.max_length,
+                    return_tensors="pt",
+                )
+                retained_tokens += int(tokens["attention_mask"].sum().item())
+                tokens = {name: tensor.to(self.device) for name, tensor in tokens.items()}
+                with self._torch.inference_mode():
+                    hidden = self.model(**tokens).last_hidden_state
+                positions = tokens["attention_mask"].sum(dim=1) - 1
+                batch_indices = self._torch.arange(hidden.shape[0], device=hidden.device)
+                pooled = hidden[batch_indices, positions]
+                normalized = self._functional.normalize(pooled.float(), p=2, dim=1)
+                if normalized.shape[1] != DIMENSIONS:
+                    raise RuntimeError("Qwen3 embedding returned an unexpected vector dimension")
+                outputs.extend(normalized.cpu().numpy().astype(np.float32).tolist())
+            return outputs, retained_tokens, truncated, (time.perf_counter() - started) * 1000
+        except Exception as error:
+            record_call(
+                role="embedding",
+                provider="local_transformers",
+                model=MODEL_ID,
+                prompt_tokens=retained_tokens or None,
+                completion_tokens=None,
+                latency_ms=(time.perf_counter() - started) * 1000,
+                success=False,
+                truncated=truncated,
+                error_type=type(error).__name__,
+            )
+            raise RuntimeError("Local Qwen3 embedding inference failed") from error
+
+    def close(self) -> None:
+        model = getattr(self, "model", None)
+        if model is None:
+            return
+        self._torch.cuda.synchronize(self.device)
+        self.model = None
+        del model
+        gc.collect()
+        self._torch.cuda.empty_cache()
+
+
+_RUNTIMES: dict[tuple[str, str, str], LocalEmbeddingRuntime] = {}
+
+
+def get_local_embedding_runtime(
+    model_path: str | Path,
+    device: str = DEFAULT_DEVICE,
+    dtype: str = DEFAULT_DTYPE,
+) -> LocalEmbeddingRuntime:
+    resolved = str(Path(model_path).expanduser().resolve())
+    key = (resolved, device, dtype)
+    if key not in _RUNTIMES:
+        _RUNTIMES[key] = LocalEmbeddingRuntime(resolved, device, dtype)
+    return _RUNTIMES[key]
+
+
+def release_local_embedding_runtimes() -> None:
+    runtimes = list(_RUNTIMES.values())
+    _RUNTIMES.clear()
+    for runtime in runtimes:
+        runtime.close()
+
+
+class LocalEmbeddingClient:
+    def __init__(self, model_path: str, system: str, question_id: str, device: str, dtype: str):
+        self.model_path = model_path
+        self.system = system
+        self.question_id = question_id
+        self.device = device
+        self.dtype = dtype
+        self.embeddings = self
+
+    def count_tokens(self, texts: list[str]) -> int:
+        return get_local_embedding_runtime(self.model_path, self.device, self.dtype).count_tokens(texts)
+
+    def create(
+        self,
+        *,
+        model: str,
+        input: str | list[str],
+        input_type: Literal["query", "document"] | None = None,
+        **_kwargs: Any,
+    ):
+        if model != MODEL_ID:
+            raise RuntimeError(f"All MEM-1 systems must use {MODEL_ID}; received {model}")
+        texts = [input] if isinstance(input, str) else list(input)
+        context = current_call_context()
+        resolved_type = input_type or (
+            "document" if context.role == "memory_ingest" else "query"
+        )
+        if resolved_type not in {"query", "document"}:
+            raise ValueError(f"Unsupported embedding input type: {resolved_type}")
+        runtime = get_local_embedding_runtime(self.model_path, self.device, self.dtype)
+        try:
+            vectors, tokens, truncated, latency = runtime.encode(texts, resolved_type)
+        except Exception:
+            raise
+        active_system = context.system if context.system != "unknown" else self.system
+        active_question = context.question_id or self.question_id
+        from agents_memory.healthcopilot_provider import call_context
+
+        with call_context(active_system, active_question, "embedding"):
+            record_call(
+                role="embedding",
+                provider="local_transformers",
+                model=MODEL_ID,
+                prompt_tokens=tokens,
+                completion_tokens=None,
+                latency_ms=latency,
+                success=True,
+                truncated=truncated,
+            )
+        data = [SimpleNamespace(index=i, embedding=vector) for i, vector in enumerate(vectors)]
+        usage = SimpleNamespace(prompt_tokens=tokens, total_tokens=tokens)
+        return SimpleNamespace(data=data, usage=usage, model=MODEL_ID)
+
+    def close(self) -> None:
+        return None
