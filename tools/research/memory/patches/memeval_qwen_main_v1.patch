+    actual_reader_request = provider.answer_request_kwargs(config, messages=[])
+
+    assert actual_reader_request["max_tokens"] == budget == 256
+    assert provider.full_context_fits(131072 - budget, 131072, budget)
+    assert not provider.full_context_fits(131072 - budget + 1, 131072, budget)
