@@ -0,0 +1,481 @@
+"""Explicit provider routing and call telemetry for Health-Copilot MEM-1."""
+
+from __future__ import annotations
+
+import contextvars
+import copy
+import json
+import os
+import sys
+import threading
+import time
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterator, Literal
+from urllib.parse import urlsplit
+
+import httpx
+from openai import AsyncOpenAI, OpenAI
+
+OPENAI_API_BASE = "https://api.openai.com/v1"
+MAIN_READER_MODEL = "health-memory-qwen3-8b"
+PARITY_READER_MODEL = "gpt-4.1"
+
+Role = Literal["reader_answer", "memory_ingest", "memory_reasoning", "embedding", "judge"]
+
+
+@dataclass(frozen=True)
+class ProviderConfig:
+    track: Literal["main", "upstream_parity"]
+    reader_provider: Literal["local_qwen", "openai"]
+    reader_base_url: str
+    reader_api_key: str
+    reader_model: str
+    openai_api_key: str
+    embedding_model: str = "text-embedding-3-small"
+    embedding_base_url: str = OPENAI_API_BASE
+    judge_model: str = "gpt-4o"
+    judge_base_url: str = OPENAI_API_BASE
+
+    @classmethod
+    def from_env(cls) -> ProviderConfig:
+        track = os.environ.get("HC_MEMORY_TRACK", "main")
+        api_key = os.environ.get("OPENAI_API_KEY", "")
+        if not api_key:
+            raise RuntimeError("OPENAI_API_KEY is required for embedding and judge roles")
+
+        embedding_base = os.environ.get("HC_EMBEDDING_BASE_URL", OPENAI_API_BASE)
+        judge_base = os.environ.get("HC_JUDGE_BASE_URL", OPENAI_API_BASE)
+        if track == "main":
+            base_url = os.environ.get("HC_LOCAL_READER_BASE_URL", "")
+            if not base_url:
+                raise RuntimeError("HC_LOCAL_READER_BASE_URL is required for the Main Track")
+            if not _is_loopback_endpoint(base_url):
+                raise RuntimeError("Main Track reader must use a loopback llama.cpp endpoint")
+            model = os.environ.get("HC_READER_MODEL", MAIN_READER_MODEL)
+            if model != MAIN_READER_MODEL:
+                raise RuntimeError(f"Main Track reader model must be {MAIN_READER_MODEL}")
+            embedding_model = os.environ.get("HC_EMBEDDING_MODEL", "text-embedding-3-small")
+            judge_model = os.environ.get("HC_JUDGE_MODEL", "gpt-4o")
+            if embedding_model != "text-embedding-3-small" or judge_model != "gpt-4o":
+                raise RuntimeError("Main Track embedding and judge models are protocol-frozen")
+            if _is_loopback_endpoint(embedding_base):
+                raise RuntimeError("Embedding provider must not use the local reader endpoint")
+            if _is_loopback_endpoint(judge_base):
+                raise RuntimeError("Judge provider must not use the local reader endpoint")
+            return cls(
+                track="main",
+                reader_provider="local_qwen",
+                reader_base_url=base_url.rstrip("/"),
+                reader_api_key=os.environ.get("HC_LOCAL_READER_API_KEY", "local-only"),
+                reader_model=model,
+                openai_api_key=api_key,
+                embedding_model=embedding_model,
+                embedding_base_url=embedding_base,
+                judge_model=judge_model,
+                judge_base_url=judge_base,
+            )
+        if track == "upstream_parity":
+            model = os.environ.get("HC_READER_MODEL", PARITY_READER_MODEL)
+            if model != PARITY_READER_MODEL:
+                raise RuntimeError(f"Upstream parity reader model must be {PARITY_READER_MODEL}")
+            base_url = os.environ.get("HC_READER_BASE_URL", OPENAI_API_BASE)
+            embedding_model = os.environ.get("HC_EMBEDDING_MODEL", "text-embedding-3-small")
+            judge_model = os.environ.get("HC_JUDGE_MODEL", "gpt-4o")
+            if embedding_model != "text-embedding-3-small" or judge_model != "gpt-4o":
+                raise RuntimeError("Upstream-parity embedding and judge models are protocol-frozen")
+            return cls(
+                track="upstream_parity",
+                reader_provider="openai",
+                reader_base_url=base_url.rstrip("/"),
+                reader_api_key=api_key,
+                reader_model=model,
+                openai_api_key=api_key,
+                embedding_model=embedding_model,
+                embedding_base_url=embedding_base,
+                judge_model=judge_model,
+                judge_base_url=judge_base,
+            )
+        raise RuntimeError("HC_MEMORY_TRACK must be 'main' or 'upstream_parity'")
+
+
+@dataclass(frozen=True)
+class CallContext:
+    system: str = "unknown"
+    question_id: str = ""
+    role: Role | None = None
+
+
+_CALL_CONTEXT: contextvars.ContextVar[CallContext] = contextvars.ContextVar(
+    "healthcopilot_mem1_call_context", default=CallContext()
+)
+_READER_INPUT: contextvars.ContextVar[list[dict[str, Any]] | None] = contextvars.ContextVar(
+    "healthcopilot_mem1_reader_input", default=None
+)
+_LEDGER_PATH: Path | None = None
+_LEDGER_LOCK = threading.Lock()
+
+
+@contextmanager
+def call_context(system: str, question_id: str, role: Role | None = None) -> Iterator[None]:
+    token = _CALL_CONTEXT.set(CallContext(system=system, question_id=question_id, role=role))
+    try:
+        yield
+    finally:
+        _CALL_CONTEXT.reset(token)
+
+
+def clear_reader_input() -> None:
+    _READER_INPUT.set(None)
+
+
+def last_reader_input() -> list[dict[str, Any]] | None:
+    value = _READER_INPUT.get()
+    return copy.deepcopy(value) if value is not None else None
+
+
+def configure_call_ledger(path: str | Path) -> None:
+    global _LEDGER_PATH
+    _LEDGER_PATH = Path(path)
+    _LEDGER_PATH.parent.mkdir(parents=True, exist_ok=True)
+
+
+def _record_call(
+    *,
+    role: Role,
+    provider: str,
+    model: str,
+    prompt_tokens: int | None,
+    completion_tokens: int | None,
+    latency_ms: float,
+    retry_count: int,
+    success: bool,
+    truncated: bool | None = None,
+    error_type: str | None = None,
+) -> None:
+    if _LEDGER_PATH is None:
+        return
+    context = _CALL_CONTEXT.get()
+    row = {
+        "question_id": context.question_id,
+        "system": context.system,
+        "role": role,
+        "provider": provider,
+        "model": model,
+        "prompt_tokens": prompt_tokens,
+        "completion_tokens": completion_tokens,
+        "latency_ms": round(latency_ms, 3),
+        "retry_count": retry_count,
+        "cache_hit": False,
+        "success": success,
+        "truncated": truncated,
+        "error_type": error_type,
+    }
+    with _LEDGER_LOCK:
+        with _LEDGER_PATH.open("a", encoding="utf-8") as ledger:
+            ledger.write(json.dumps(row, ensure_ascii=False) + "\n")
+
+
+def _telemetry_client(
+    role: Role,
+    provider: str,
+    system: str,
+    question_id: str,
+    transport: httpx.BaseTransport | None = None,
+) -> httpx.Client:
+    def on_request(request: httpx.Request) -> None:
+        request.extensions["hc_mem1_started"] = time.perf_counter()
+        active_context = _CALL_CONTEXT.get()
+        request.extensions["hc_mem1_context"] = (
+            active_context
+            if active_context.system != "unknown"
+            else CallContext(system=system, question_id=question_id)
+        )
+
+    def role_for(context: CallContext) -> Role:
+        return (
+            context.role
+            if role in ("reader_answer", "memory_ingest", "memory_reasoning")
+            and context.role in ("reader_answer", "memory_ingest", "memory_reasoning")
+            else role
+        )
+
+    def on_response(response: httpx.Response) -> None:
+        response.read()
+        request = response.request
+        started = request.extensions.get("hc_mem1_started", time.perf_counter())
+        context = request.extensions.get("hc_mem1_context", CallContext(system=system))
+        try:
+            request_body = json.loads(request.content.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            request_body = {}
+        try:
+            response_body = response.json()
+        except (ValueError, json.JSONDecodeError):
+            response_body = {}
+        usage = response_body.get("usage", {}) if isinstance(response_body, dict) else {}
+        retry_header = request.headers.get("x-stainless-retry-count", "0")
+        try:
+            retry_count = int(retry_header)
+        except ValueError:
+            retry_count = 0
+        call_role = role_for(context)
+        with call_context(context.system, context.question_id, call_role):
+            _record_call(
+                role=call_role,
+                provider=provider,
+                model=str(request_body.get("model", "unknown")),
+                prompt_tokens=usage.get("prompt_tokens", usage.get("input_tokens")),
+                completion_tokens=usage.get("completion_tokens", usage.get("output_tokens")),
+                latency_ms=(time.perf_counter() - started) * 1000,
+                retry_count=retry_count,
+                success=response.status_code < 400,
+                truncated=(
+                    response_body.get("truncated")
+                    if isinstance(response_body, dict)
+                    else None
+                ),
+            )
+
+    class TelemetryClient(httpx.Client):
+        def send(self, request: httpx.Request, **kwargs: Any) -> httpx.Response:
+            started = request.extensions.get("hc_mem1_started", time.perf_counter())
+            try:
+                return super().send(request, **kwargs)
+            except Exception as error:
+                context = request.extensions.get(
+                    "hc_mem1_context", CallContext(system=system, question_id=question_id)
+                )
+                with call_context(context.system, context.question_id, role_for(context)):
+                    _record_call(
+                        role=role_for(context),
+                        provider=provider,
+                        model="unknown",
+                        prompt_tokens=None,
+                        completion_tokens=None,
+                        latency_ms=(time.perf_counter() - started) * 1000,
+                        retry_count=0,
+                        success=False,
+                        error_type=type(error).__name__,
+                    )
+                raise
+
+    return TelemetryClient(
+        event_hooks={"request": [on_request], "response": [on_response]},
+        trust_env=provider != "local_qwen",
+        transport=transport,
+    )
+
+
+def _client(
+    *,
+    base_url: str,
+    api_key: str,
+    role: Role,
+    provider: str,
+    system: str,
+    question_id: str,
+    transport: httpx.BaseTransport | None = None,
+) -> OpenAI:
+    if not base_url or not api_key:
+        raise RuntimeError(f"Missing explicit endpoint or key for {role}")
+    return OpenAI(
+        api_key=api_key,
+        base_url=base_url,
+        http_client=_telemetry_client(role, provider, system, question_id, transport),
+    )
+
+
+def _is_loopback_endpoint(base_url: str) -> bool:
+    try:
+        return urlsplit(base_url).hostname in {"127.0.0.1", "localhost", "::1"}
+    except ValueError:
+        return False
+
+
+def _validate_provider_routes(config: ProviderConfig) -> None:
+    reader_is_local = _is_loopback_endpoint(config.reader_base_url)
+    embedding_is_local = _is_loopback_endpoint(config.embedding_base_url)
+    judge_is_local = _is_loopback_endpoint(config.judge_base_url)
+    if config.track == "main":
+        if not reader_is_local or config.reader_provider != "local_qwen":
+            raise RuntimeError("Main Track reader must be routed to the local Qwen endpoint")
+        if config.reader_model != MAIN_READER_MODEL:
+            raise RuntimeError(f"Main Track reader model must be {MAIN_READER_MODEL}")
+    else:
+        if reader_is_local or config.reader_provider != "openai":
+            raise RuntimeError(
+                "Upstream-parity reader must use the configured GPT-4.1 API endpoint"
+            )
+        if config.reader_model != PARITY_READER_MODEL:
+            raise RuntimeError(f"Upstream-parity reader model must be {PARITY_READER_MODEL}")
+    if config.embedding_model != "text-embedding-3-small":
+        raise RuntimeError("Embedding model is protocol-frozen to text-embedding-3-small")
+    if embedding_is_local:
+        raise RuntimeError("Embedding client must not use the local reader endpoint")
+    if judge_is_local:
+        raise RuntimeError("Judge client must not use the local reader endpoint")
+    if config.judge_model != "gpt-4o":
+        raise RuntimeError("LongMemEval native judge is protocol-frozen to gpt-4o")
+
+
+class _ReaderCompletions:
+    def __init__(self, raw: OpenAI, config: ProviderConfig, default_role: Role):
+        self._raw = raw
+        self._config = config
+        self._default_role = default_role
+
+    def create(self, **kwargs: Any) -> Any:
+        request = dict(kwargs)
+        request["model"] = self._config.reader_model
+        active_role = _CALL_CONTEXT.get().role or self._default_role
+        if self._config.track == "main":
+            request["temperature"] = 0
+            request["seed"] = 42
+            if active_role == "reader_answer":
+                request.pop("max_completion_tokens", None)
+                request["max_tokens"] = 64
+            extra_body = request.get("extra_body")
+            extra_body = copy.deepcopy(extra_body) if isinstance(extra_body, dict) else {}
+            template_kwargs = extra_body.get("chat_template_kwargs", {})
+            template_kwargs["enable_thinking"] = False
+            extra_body["chat_template_kwargs"] = template_kwargs
+            request["extra_body"] = extra_body
+        if active_role == "reader_answer" and isinstance(request.get("messages"), list):
+            _READER_INPUT.set(copy.deepcopy(request["messages"]))
+        return self._raw.chat.completions.create(**request)
+
+
+class _ReaderClient:
+    def __init__(self, raw: OpenAI, config: ProviderConfig, default_role: Role):
+        self._raw = raw
+        self.chat = type(
+            "ChatProxy",
+            (),
+            {"completions": _ReaderCompletions(raw, config, default_role)},
+        )()
+        self.embeddings = raw.embeddings
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._raw, name)
+
+
+def reader_client(
+    role: Literal["reader_answer", "memory_ingest", "memory_reasoning"],
+    system: str,
+    question_id: str,
+    config: ProviderConfig | None = None,
+) -> OpenAI:
+    config = config or ProviderConfig.from_env()
+    _validate_provider_routes(config)
+    with call_context(system, question_id):
+        raw = _client(
+            base_url=config.reader_base_url,
+            api_key=config.reader_api_key,
+            role=role,
+            provider=config.reader_provider,
+            system=system,
+            question_id=question_id,
+        )
+    return _ReaderClient(raw, config, role)  # type: ignore[return-value]
+
+
+def embedding_client(system: str, question_id: str, config: ProviderConfig | None = None) -> OpenAI:
+    config = config or ProviderConfig.from_env()
+    _validate_provider_routes(config)
+    return _client(
+        base_url=config.embedding_base_url,
+        api_key=config.openai_api_key,
+        role="embedding",
+        provider="openai",
+        system=system,
+        question_id=question_id,
+    )
+
+
+def judge_client(system: str, question_id: str, config: ProviderConfig | None = None) -> OpenAI:
+    config = config or ProviderConfig.from_env()
+    _validate_provider_routes(config)
+    return _client(
+        base_url=config.judge_base_url,
+        api_key=config.openai_api_key,
+        role="judge",
+        provider="openai",
+        system=system,
+        question_id=question_id,
+    )
+
+
+def validate_reader_model(config: ProviderConfig, requested_model: str) -> None:
+    if requested_model != config.reader_model:
+        raise RuntimeError(
+            f"Configured reader is {config.reader_model}; received {requested_model}"
+        )
+
+
+@contextmanager
+def scoped_memory_llm_environment(config: ProviderConfig) -> Iterator[None]:
+    """Scope env-only third-party LLM clients without redirecting API roles."""
+    keys = ("OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_API_BASE", "OPENROUTER_API_KEY")
+    previous = {key: os.environ.get(key) for key in keys}
+    os.environ["OPENAI_API_KEY"] = config.reader_api_key
+    os.environ["OPENAI_BASE_URL"] = config.reader_base_url
+    os.environ.pop("OPENAI_API_BASE", None)
+    os.environ.pop("OPENROUTER_API_KEY", None)
+    try:
+        yield
+    finally:
+        for key, value in previous.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+
+
+def patch_openai_aliases(
+    package_prefix: str,
+    *,
+    role: Literal["memory_ingest", "memory_reasoning"],
+    system: str,
+    question_id: str,
+    config: ProviderConfig,
+) -> int:
+    """Replace already-imported third-party OpenAI aliases with the bound reader."""
+    patched = 0
+
+    def factory(*_args: Any, **_kwargs: Any) -> OpenAI:
+        return reader_client(role, system, question_id, config)
+
+    for module in tuple(sys.modules.values()):
+        name = getattr(module, "__name__", "")
+        if not name.startswith(package_prefix):
+            continue
+        if getattr(module, "AsyncOpenAI", None) is AsyncOpenAI:
+            raise RuntimeError(f"Async OpenAI client in {name} needs an explicit adapter")
+        if getattr(module, "OpenAI", None) is OpenAI:
+            setattr(module, "OpenAI", factory)
+            patched += 1
+    return patched
+
+
+def answer_request_kwargs(
+    config: ProviderConfig,
+    model: str | None = None,
+    **kwargs: Any,
+) -> dict[str, Any]:
+    request = {
+        "model": model or config.reader_model,
+        **kwargs,
+    }
+    if config.track == "main":
+        request["temperature"] = 0
+        request["seed"] = 42
+        request.setdefault("max_tokens", 64)
+        extra_body = request.get("extra_body")
+        extra_body = copy.deepcopy(extra_body) if isinstance(extra_body, dict) else {}
+        template_kwargs = extra_body.get("chat_template_kwargs", {})
+        template_kwargs["enable_thinking"] = False
+        extra_body["chat_template_kwargs"] = template_kwargs
+        request["extra_body"] = extra_body
+    return request
