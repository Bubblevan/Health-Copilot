+        set_config(config)
+        memory = SimpleMemSystem(clear_db=True)
+        with call_context("SimpleMem", sample_id, "memory_ingest"):
+            memory.add_dialogues(dialogue_objects)
+            memory.finalize()
+    print(f"    Dialogues ingested: {len(dialogue_objects)}; patched clients={patched}")
+
+    def answer_fn(question: str) -> str:
+        with scoped_memory_llm_environment(provider_config):
+            with call_context("SimpleMem", sample_id, "reader_answer"):
+                return memory.ask(question)
+
+    try:
+        return _qa_results(
+            conv,
+            answer_fn,
+            run_judge,
+            category_names=category_names,
+            judge_fn=judge_fn,
+            system_name="SimpleMem",
+        )
+    finally:
+        _embed_client.close()
+        _embed_client = None
