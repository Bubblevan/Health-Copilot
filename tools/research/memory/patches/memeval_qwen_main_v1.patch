+import json
+
+import httpx
+import pytest
+
+from agents_memory import healthcopilot_provider as provider
+
+
+def main_config() -> provider.ProviderConfig:
+    return provider.ProviderConfig(
+        track="main",
+        reader_provider="local_qwen",
+        reader_base_url="http://127.0.0.1:8080/v1",
+        reader_api_key="local-only",
+        reader_model=provider.MAIN_READER_MODEL,
+        openai_api_key="test-openai-key",
+    )
+
+
+def test_main_provider_roles_ignore_global_openai_base_url(monkeypatch):
+    monkeypatch.setenv("HC_MEMORY_TRACK", "main")
+    monkeypatch.setenv("HC_LOCAL_READER_BASE_URL", "http://127.0.0.1:8080/v1")
+    monkeypatch.setenv("OPENAI_API_KEY", "test-openai-key")
+    monkeypatch.setenv("OPENAI_BASE_URL", "http://127.0.0.1:9999/v1")
+    monkeypatch.delenv("HC_EMBEDDING_BASE_URL", raising=False)
+    monkeypatch.delenv("HC_JUDGE_BASE_URL", raising=False)
+    config = provider.ProviderConfig.from_env()
+
+    assert config.reader_base_url == "http://127.0.0.1:8080/v1"
+    assert config.embedding_base_url == provider.OPENAI_API_BASE
+    assert config.judge_base_url == provider.OPENAI_API_BASE
+
+
+def test_main_track_refuses_missing_or_nonlocal_reader(monkeypatch):
+    monkeypatch.setenv("HC_MEMORY_TRACK", "main")
+    monkeypatch.setenv("OPENAI_API_KEY", "test-openai-key")
+    monkeypatch.delenv("HC_LOCAL_READER_BASE_URL", raising=False)
+    with pytest.raises(RuntimeError, match="HC_LOCAL_READER_BASE_URL"):
+        provider.ProviderConfig.from_env()
+
+    monkeypatch.setenv("HC_LOCAL_READER_BASE_URL", "https://api.openai.com/v1")
+    with pytest.raises(RuntimeError, match="loopback"):
+        provider.ProviderConfig.from_env()
+
+    monkeypatch.setenv("HC_LOCAL_READER_BASE_URL", "http://127.0.0.1.evil.invalid/v1")
+    with pytest.raises(RuntimeError, match="loopback"):
+        provider.ProviderConfig.from_env()
+
+
+class FakeOpenAI:
+    calls = []
+
+    def __init__(self, **kwargs):
+        self.calls.append(kwargs)
+        self.chat = type("Chat", (), {"completions": type("Completions", (), {})()})()
+        self.chat.completions.create = lambda **request: request
+        self.embeddings = object()
+
+
+def test_factories_bind_reader_embedding_and_judge_to_separate_hosts(monkeypatch):
+    FakeOpenAI.calls = []
+    monkeypatch.setattr(provider, "OpenAI", FakeOpenAI)
+    config = main_config()
+
+    provider.reader_client("reader_answer", "FullContext", "q1", config)
+    provider.embedding_client("OpenClaw", "q2", config)
+    provider.judge_client("OpenClaw", "q2", config)
+
+    assert [c["base_url"] for c in FakeOpenAI.calls] == [
+        "http://127.0.0.1:8080/v1",
+        "https://api.openai.com/v1",
+        "https://api.openai.com/v1",
+    ]
+    assert [c["api_key"] for c in FakeOpenAI.calls] == [
+        "local-only",
+        "test-openai-key",
+        "test-openai-key",
+    ]
+
+
+def test_factories_fail_closed_on_cross_role_endpoint_leakage():
+    config = main_config()
+    local_embedding = provider.ProviderConfig(
+        **{**config.__dict__, "embedding_base_url": "http://localhost:8080/v1"}
+    )
+    local_judge = provider.ProviderConfig(
+        **{**config.__dict__, "judge_base_url": "http://127.0.0.1:8080/v1"}
+    )
+    cloud_reader = provider.ProviderConfig(
+        **{
+            **config.__dict__,
+            "reader_provider": "openai",
+            "reader_base_url": "https://api.openai.com/v1",
+        }
+    )
+
+    with pytest.raises(RuntimeError, match="Embedding client"):
+        provider.embedding_client("OpenClaw", "q1", local_embedding)
+    with pytest.raises(RuntimeError, match="Judge client"):
+        provider.judge_client("FullContext", "q1", local_judge)
+    with pytest.raises(RuntimeError, match="local Qwen"):
+        provider.reader_client("reader_answer", "FullContext", "q1", cloud_reader)
+
+
+def test_reader_proxy_enforces_main_controls_but_preserves_ingest_budget():
+    class Raw:
+        def __init__(self):
+            self.chat = type("Chat", (), {"completions": type("Completions", (), {})()})()
+            self.chat.completions.create = lambda **request: request
+
+    config = main_config()
+    raw = Raw()
+    answer = provider._ReaderCompletions(raw, config, "reader_answer").create(
+        model="wrong-model",
+        temperature=0.7,
+        seed=1,
+        max_tokens=2,
+        messages=[],
+    )
+    assert answer["model"] == provider.MAIN_READER_MODEL
+    assert answer["temperature"] == 0
+    assert answer["seed"] == 42
+    assert answer["max_tokens"] == 64
+    assert answer["extra_body"]["chat_template_kwargs"]["enable_thinking"] is False
+
+    ingest = provider._ReaderCompletions(raw, config, "memory_ingest").create(
+        model="wrong-model", temperature=0.7, seed=1, max_tokens=8192, messages=[]
+    )
+    assert ingest["max_tokens"] == 8192
+    assert ingest["temperature"] == 0
+    assert ingest["seed"] == 42
+
+
+def test_upstream_parity_reader_keeps_upstream_sampling_controls():
+    class Raw:
+        def __init__(self):
+            self.chat = type("Chat", (), {"completions": type("Completions", (), {})()})()
+            self.chat.completions.create = lambda **request: request
+
+    config = provider.ProviderConfig(
+        track="upstream_parity",
+        reader_provider="openai",
+        reader_base_url=provider.OPENAI_API_BASE,
+        reader_api_key="test-openai-key",
+        reader_model=provider.PARITY_READER_MODEL,
+        openai_api_key="test-openai-key",
+    )
+    result = provider._ReaderCompletions(Raw(), config, "reader_answer").create(
+        model="wrong-model", max_tokens=50, temperature=0.1, messages=[]
+    )
+    assert result["model"] == "gpt-4.1"
+    assert result["max_tokens"] == 50
+    assert result["temperature"] == 0.1
+    assert "seed" not in result
+
+
+def test_call_ledger_records_usage_without_request_body_or_credentials(tmp_path):
+    ledger = tmp_path / "calls.jsonl"
+    provider.configure_call_ledger(ledger)
+    transport = httpx.MockTransport(
+        lambda request: httpx.Response(
+            200,
+            json={"usage": {"prompt_tokens": 17, "completion_tokens": 3}},
+            request=request,
+        )
+    )
+    client = provider._telemetry_client(
+        "reader_answer", "local_qwen", "FullContext", "q1", transport
+    )
+    with provider.call_context("FullContext", "q1", "reader_answer"):
+        client.post(
+            "http://127.0.0.1:8080/v1/chat/completions",
+            json={"model": "health-memory-qwen3-8b", "messages": [{"content": "private"}]},
+            headers={"Authorization": "Bearer secret"},
+        )
+
+    row = json.loads(ledger.read_text(encoding="utf-8"))
+    assert row["role"] == "reader_answer"
+    assert row["provider"] == "local_qwen"
+    assert row["model"] == provider.MAIN_READER_MODEL
+    assert row["prompt_tokens"] == 17
+    assert row["completion_tokens"] == 3
+    assert row["success"] is True
+    assert "private" not in ledger.read_text(encoding="utf-8")
+    assert "secret" not in ledger.read_text(encoding="utf-8")
+    client.close()
+
+
+def test_transport_failure_is_recorded_without_request_content(tmp_path):
+    ledger = tmp_path / "calls.jsonl"
+    provider.configure_call_ledger(ledger)
+
+    def fail(_request):
+        raise httpx.ConnectError("offline", request=_request)
+
+    client = provider._telemetry_client(
+        "reader_answer", "local_qwen", "FullContext", "q2", httpx.MockTransport(fail)
+    )
+    with provider.call_context("FullContext", "q2", "reader_answer"):
+        with pytest.raises(httpx.ConnectError):
+            client.post(
+                "http://127.0.0.1:8080/v1/chat/completions",
+                json={"model": provider.MAIN_READER_MODEL, "messages": [{"content": "private"}]},
+                headers={"Authorization": "Bearer secret"},
+            )
+
+    row = json.loads(ledger.read_text(encoding="utf-8"))
+    assert row["question_id"] == "q2"
+    assert row["success"] is False
+    assert row["error_type"] == "ConnectError"
+    assert row["prompt_tokens"] is None
+    assert "private" not in ledger.read_text(encoding="utf-8")
+    assert "secret" not in ledger.read_text(encoding="utf-8")
+    client.close()
