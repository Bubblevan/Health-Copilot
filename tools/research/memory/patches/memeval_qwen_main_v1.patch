+def _answer_from_json_content(content: str) -> str:
+    """Read PropMem's answer, tolerating Qwen's missing final object brace."""
+    def unique_object(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError(f"Duplicate PropMem answer JSON field: {key}")
+            result[key] = value
+        return result
+
+    try:
+        payload = json.loads(content, object_pairs_hook=unique_object)
+    except json.JSONDecodeError:
+        # Accept only the single known truncation: a complete JSON object body
+        # with its final outer brace omitted. Strict parsing rejects partial
+        # strings, missing fields, malformed values, and trailing text.
+        candidate = content.rstrip()
+        if not candidate.startswith("{") or candidate.endswith("}"):
+            raise
+        final_string = re.search(r'("(?:\\.|[^"\\])*")\s*$', candidate)
+        if final_string is None or re.search(
+            r'"answer"\s*:\s*$', candidate[:final_string.start()]
+        ) is None:
+            raise
+        payload = json.loads(candidate + "}", object_pairs_hook=unique_object)
+        if not isinstance(payload, dict) or payload.get("answer") != json.loads(final_string.group(1)):
+            raise
+    if (
