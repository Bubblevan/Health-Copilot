+def test_simplemem_planner_uses_memory_reasoning_without_changing_answer_role():
+    seen = []
+
+    class Retriever:
+        def retrieve(self, question):
+            seen.append((question, current_call_context().role))
+            return ["memory"]
+
+    class Memory:
+        hybrid_retriever = Retriever()
+
+    memory = Memory()
+    _install_tracked_retriever(memory, "q1")
+
+    with call_context("SimpleMem", "q1", "reader_answer"):
+        result = memory.hybrid_retriever.retrieve("question")
+        answer_role_after_retrieval = current_call_context().role
+
+    assert seen == [("question", "memory_reasoning")]
+    assert result == ["memory"]
+    assert memory._healthcopilot_retrieved_contexts == ["memory"]
+    assert answer_role_after_retrieval == "reader_answer"
