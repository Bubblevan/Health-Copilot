+import asyncio
+import importlib.util
+from pathlib import Path
+
+from agents_memory import evaluation
+from agents_memory.healthcopilot_provider import ProviderConfig
+
+_helpers_path = (
+    Path(__file__).parents[1] / "src" / "agents_memory" / "systems" / "_helpers.py"
+)
+_spec = importlib.util.spec_from_file_location("mem1_test_helpers", _helpers_path)
+_helpers = importlib.util.module_from_spec(_spec)
+assert _spec.loader is not None
+_spec.loader.exec_module(_helpers)
+_qa_results_async = _helpers._qa_results_async
+
+
+def test_reader_infrastructure_failure_is_not_zero_quality_or_judged():
+    async def fail(_question):
+        raise TimeoutError("local reader unavailable")
+
+    rows = asyncio.run(
+        _qa_results_async(
+            {
+                "sample_id": "q1",
+                "qa": [
+                    {
+                        "question_id": "q1",
+                        "question": "What did they choose?",
+                        "answer": "Swimming",
+                        "category": "knowledge-update",
+                    }
+                ],
+            },
+            fail,
+            run_judge=True,
+            judge_fn="longmemeval",
+            system_name="FullContext",
+        )
+    )
+
+    assert rows[0]["quality_status"] == "INFRA_FAILURE"
+    assert rows[0]["predicted"] is None
+    assert rows[0]["f1"] is None
+    assert "longmemeval_correct" not in rows[0]
+
+
+def test_judge_failure_is_null_after_bounded_retries(monkeypatch):
+    config = ProviderConfig(
+        track="main",
+        reader_provider="local_qwen",
+        reader_base_url="http://127.0.0.1:8080/v1",
+        reader_api_key="local-only",
+        reader_model="health-memory-qwen3-8b",
+        openai_api_key="test-openai-key",
+    )
+
+    class FailingCompletions:
+        calls = 0
+
+        def create(self, **_kwargs):
+            self.calls += 1
+            raise TimeoutError("judge unavailable")
+
+    failing = FailingCompletions()
+    fake_client = type(
+        "Client",
+        (),
+        {"chat": type("Chat", (), {"completions": failing})()},
+    )()
+    monkeypatch.setattr(evaluation.ProviderConfig, "from_env", lambda: config)
+    monkeypatch.setattr(evaluation, "judge_client", lambda *_args: fake_client)
+    monkeypatch.setattr(evaluation.time, "sleep", lambda *_args: None)
+
+    result = evaluation.evaluate_longmemeval(
+        "Question", "Expected", "Prediction", category="multi-session", question_id="q1"
+    )
+
+    assert failing.calls == 3
+    assert result["judge_status"] == "ERROR"
+    assert result["longmemeval_correct"] is None
+
+
+def test_memory_llm_environment_is_scoped_and_restored(monkeypatch):
+    from agents_memory.healthcopilot_provider import scoped_memory_llm_environment
+
+    config = ProviderConfig(
+        track="main",
+        reader_provider="local_qwen",
+        reader_base_url="http://127.0.0.1:8080/v1",
+        reader_api_key="local-only",
+        reader_model="health-memory-qwen3-8b",
+        openai_api_key="test-openai-key",
+    )
+    monkeypatch.setenv("OPENAI_BASE_URL", "https://proxy.invalid/v1")
+    monkeypatch.setenv("OPENAI_API_KEY", "cloud-key")
+    monkeypatch.setenv("OPENROUTER_API_KEY", "router-key")
+
+    with scoped_memory_llm_environment(config):
+        assert __import__("os").environ["OPENAI_BASE_URL"] == config.reader_base_url
+        assert __import__("os").environ["OPENAI_API_KEY"] == config.reader_api_key
+        assert "OPENROUTER_API_KEY" not in __import__("os").environ
+
+    assert __import__("os").environ["OPENAI_BASE_URL"] == "https://proxy.invalid/v1"
+    assert __import__("os").environ["OPENAI_API_KEY"] == "cloud-key"
+    assert __import__("os").environ["OPENROUTER_API_KEY"] == "router-key"
