@@ -0,0 +1,548 @@
+"""Fail-closed local provider routing and call telemetry for MEM-1."""
+
+from __future__ import annotations
+
+import contextvars
+import copy
+import json
+import os
+import sys
+import threading
+import time
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterator, Literal
+from urllib.parse import urlsplit, urlunsplit
+
+import httpx
+from openai import AsyncOpenAI, OpenAI
+
+MAIN_READER_MODEL = "health-memory-qwen3-8b"
+EMBEDDING_MODEL = "Qwen/Qwen3-Embedding-0.6B"
+LOCAL_REQUEST_TIMEOUT_SECONDS = 3600.0
+LOCAL_REQUEST_MAX_RETRIES = 2
+READER_ANSWER_MAX_NEW_TOKENS = 256
+
+Role = Literal[
+    "reader_answer", "memory_ingest", "memory_reasoning", "embedding", "judge_local"
+]
+
+
+@dataclass(frozen=True)
+class ProviderConfig:
+    track: Literal["main_local_only"]
+    reader_provider: Literal["local_qwen"]
+    reader_base_url: str
+    local_protocol_token: str
+    reader_model: str
+    embedding_model: str = EMBEDDING_MODEL
+    embedding_path: str = ""
+    embedding_device: str = "cuda:0"
+    embedding_dtype: str = "float16"
+    request_timeout_seconds: float = LOCAL_REQUEST_TIMEOUT_SECONDS
+    max_retries: int = LOCAL_REQUEST_MAX_RETRIES
+    reader_answer_max_new_tokens: int = READER_ANSWER_MAX_NEW_TOKENS
+
+    @classmethod
+    def from_env(cls) -> ProviderConfig:
+        base_url = os.environ.get("HC_LOCAL_READER_BASE_URL", "")
+        if not _is_loopback_endpoint(base_url):
+            raise RuntimeError(
+                "HC_LOCAL_READER_BASE_URL must be an explicit loopback llama.cpp endpoint"
+            )
+        model = os.environ.get("HC_READER_MODEL", MAIN_READER_MODEL)
+        if model != MAIN_READER_MODEL:
+            raise RuntimeError(f"MEM-1 reader model is frozen to {MAIN_READER_MODEL}")
+        embedding_model = os.environ.get("HC_EMBEDDING_MODEL", EMBEDDING_MODEL)
+        if embedding_model != EMBEDDING_MODEL:
+            raise RuntimeError(f"MEM-1 embedding model is frozen to {EMBEDDING_MODEL}")
+        embedding_path = os.environ.get("HC_LOCAL_EMBEDDING_PATH", "")
+        if not embedding_path:
+            raise RuntimeError("HC_LOCAL_EMBEDDING_PATH must point to the frozen local model")
+        embedding_device = os.environ.get("HC_LOCAL_EMBEDDING_DEVICE", "cuda:0")
+        embedding_dtype = os.environ.get("HC_LOCAL_EMBEDDING_DTYPE", "float16")
+        if embedding_device != "cuda:0" or embedding_dtype != "float16":
+            raise RuntimeError("MEM-1 embedding is frozen to cuda:0 / float16")
+        answer_budget = int(os.environ.get(
+            "HC_READER_ANSWER_MAX_NEW_TOKENS",
+            str(READER_ANSWER_MAX_NEW_TOKENS),
+        ))
+        if answer_budget < 1:
+            raise RuntimeError("HC_READER_ANSWER_MAX_NEW_TOKENS must be positive")
+        return cls(
+            track="main_local_only",
+            reader_provider="local_qwen",
+            reader_base_url=base_url.rstrip("/"),
+            local_protocol_token="local-only",
+            reader_model=model,
+            embedding_model=embedding_model,
+            embedding_path=embedding_path,
+            embedding_device=embedding_device,
+            embedding_dtype=embedding_dtype,
+            reader_answer_max_new_tokens=answer_budget,
+        )
+
+
+@dataclass(frozen=True)
+class CallContext:
+    system: str = "unknown"
+    question_id: str = ""
+    role: Role | None = None
+
+
+_CALL_CONTEXT: contextvars.ContextVar[CallContext] = contextvars.ContextVar(
+    "healthcopilot_mem1_call_context", default=CallContext()
+)
+_READER_INPUT: contextvars.ContextVar[list[dict[str, Any]] | None] = contextvars.ContextVar(
+    "healthcopilot_mem1_reader_input", default=None
+)
+_LEDGER_PATH: Path | None = None
+_LEDGER_LOCK = threading.Lock()
+_QUESTION_METRICS: contextvars.ContextVar[dict[str, Any]] = contextvars.ContextVar(
+    "healthcopilot_mem1_question_metrics", default={}
+)
+_FULL_CONTEXT_EXPECTATION: contextvars.ContextVar[dict[str, int] | None] = contextvars.ContextVar(
+    "healthcopilot_mem1_full_context_expectation", default=None
+)
+
+
+@contextmanager
+def call_context(system: str, question_id: str, role: Role | None = None) -> Iterator[None]:
+    token = _CALL_CONTEXT.set(CallContext(system=system, question_id=question_id, role=role))
+    try:
+        yield
+    finally:
+        _CALL_CONTEXT.reset(token)
+
+
+def current_call_context() -> CallContext:
+    return _CALL_CONTEXT.get()
+
+
+def clear_question_metrics(*, preserve_ingestion: bool = False) -> None:
+    previous = _QUESTION_METRICS.get()
+    metrics = {}
+    if preserve_ingestion and previous.get("ingestion_latency_ms") is not None:
+        metrics["ingestion_latency_ms"] = previous["ingestion_latency_ms"]
+    _QUESTION_METRICS.set(metrics)
+
+
+def record_ingestion_latency(latency_ms: float) -> None:
+    metrics = copy.deepcopy(_QUESTION_METRICS.get())
+    metrics["ingestion_latency_ms"] = round(latency_ms, 3)
+    _QUESTION_METRICS.set(metrics)
+
+
+def record_retrieval_metrics(
+    *,
+    texts: list[str],
+    session_ids: list[str],
+    latency_ms: float,
+    context_tokens: int,
+    session_provenance_available: bool = True,
+    ranked_session_groups: list[list[str]] | None = None,
+) -> None:
+    metrics = copy.deepcopy(_QUESTION_METRICS.get())
+    ordered_sessions = list(dict.fromkeys(str(value) for value in session_ids if value))
+    metrics.update({
+        "retrieved_session_ids": ordered_sessions,
+        "retrieved_context_tokens": context_tokens,
+        "retrieved_record_count": len(texts),
+        "retrieval_latency_ms": round(latency_ms, 3),
+        "session_provenance_available": session_provenance_available,
+        "ranked_session_groups": ranked_session_groups,
+    })
+    _QUESTION_METRICS.set(metrics)
+
+
+def question_metrics() -> dict[str, Any]:
+    return copy.deepcopy(_QUESTION_METRICS.get())
+
+
+def clear_reader_input() -> None:
+    _READER_INPUT.set(None)
+
+
+def last_reader_input() -> list[dict[str, Any]] | None:
+    value = _READER_INPUT.get()
+    return copy.deepcopy(value) if value is not None else None
+
+
+def configure_call_ledger(path: str | Path) -> None:
+    global _LEDGER_PATH
+    _LEDGER_PATH = Path(path)
+    _LEDGER_PATH.parent.mkdir(parents=True, exist_ok=True)
+
+
+def record_call(
+    *,
+    role: Role,
+    provider: str,
+    model: str,
+    prompt_tokens: int | None,
+    completion_tokens: int | None,
+    latency_ms: float,
+    retry_count: int = 0,
+    success: bool,
+    truncated: bool | None = None,
+    error_type: str | None = None,
+    max_model_length: int | None = None,
+) -> None:
+    if _LEDGER_PATH is None:
+        return
+    context = _CALL_CONTEXT.get()
+    row = {
+        "question_id": context.question_id,
+        "system": _system_key(context.system),
+        "role": role,
+        "provider": provider,
+        "model": model,
+        "prompt_tokens": prompt_tokens,
+        "completion_tokens": completion_tokens,
+        "latency_ms": round(latency_ms, 3),
+        "retry_count": retry_count,
+        "cache_hit": False,
+        "success": success,
+        "truncated": truncated,
+        "error_type": error_type,
+        "max_model_length": max_model_length,
+    }
+    with _LEDGER_LOCK:
+        with _LEDGER_PATH.open("a", encoding="utf-8") as ledger:
+            ledger.write(json.dumps(row, ensure_ascii=False) + "\n")
+
+
+def _telemetry_client(
+    role: Role,
+    system: str,
+    question_id: str,
+    transport: httpx.BaseTransport | None = None,
+) -> httpx.Client:
+    def on_request(request: httpx.Request) -> None:
+        request.extensions["hc_mem1_started"] = time.perf_counter()
+        active_context = _CALL_CONTEXT.get()
+        request.extensions["hc_mem1_context"] = (
+            active_context
+            if active_context.system != "unknown"
+            else CallContext(system=system, question_id=question_id, role=role)
+        )
+
+    def on_response(response: httpx.Response) -> None:
+        response.read()
+        request = response.request
+        started = request.extensions.get("hc_mem1_started", time.perf_counter())
+        context = request.extensions.get("hc_mem1_context", CallContext(system=system))
+        try:
+            request_body = json.loads(request.content.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            request_body = {}
+        try:
+            response_body = response.json()
+        except (ValueError, json.JSONDecodeError):
+            response_body = {}
+        usage = response_body.get("usage", {}) if isinstance(response_body, dict) else {}
+        truncated = response_body.get("truncated") if isinstance(response_body, dict) else None
+        prompt_tokens = usage.get("prompt_tokens", usage.get("input_tokens"))
+        max_model_length = None
+        expectation = _FULL_CONTEXT_EXPECTATION.get()
+        if expectation is not None:
+            max_model_length = expectation["max_model_length"]
+            measured_tokens = expectation["prompt_tokens"]
+            if response.status_code < 400:
+                truncated = (
+                    measured_tokens + expectation["output_reserve"] > max_model_length
+                    or (prompt_tokens is not None and prompt_tokens != measured_tokens)
+                )
+                prompt_tokens = measured_tokens
+            _FULL_CONTEXT_EXPECTATION.set(None)
+        active_role = context.role or role
+        with call_context(context.system, context.question_id, active_role):
+            record_call(
+                role=active_role,
+                provider="local_qwen",
+                model=str(request_body.get("model", MAIN_READER_MODEL)),
+                prompt_tokens=prompt_tokens,
+                completion_tokens=usage.get("completion_tokens", usage.get("output_tokens")),
+                latency_ms=(time.perf_counter() - started) * 1000,
+                success=response.status_code < 400,
+                truncated=truncated,
+                max_model_length=max_model_length,
+            )
+
+    class TelemetryClient(httpx.Client):
+        def send(self, request: httpx.Request, **kwargs: Any) -> httpx.Response:
+            started = request.extensions.get("hc_mem1_started", time.perf_counter())
+            try:
+                host = request.url.host
+                if host not in {"127.0.0.1", "localhost", "::1"}:
+                    raise RuntimeError("MEM-1 blocked a non-loopback model request")
+                return super().send(request, **kwargs)
+            except Exception as error:
+                _FULL_CONTEXT_EXPECTATION.set(None)
+                context = request.extensions.get(
+                    "hc_mem1_context", CallContext(system=system, question_id=question_id)
+                )
+                active_role = context.role or role
+                with call_context(context.system, context.question_id, active_role):
+                    record_call(
+                        role=active_role,
+                        provider="local_qwen",
+                        model="unknown",
+                        prompt_tokens=None,
+                        completion_tokens=None,
+                        latency_ms=(time.perf_counter() - started) * 1000,
+                        success=False,
+                        error_type=type(error).__name__,
+                    )
+                raise
+
+    return TelemetryClient(
+        event_hooks={"request": [on_request], "response": [on_response]},
+        trust_env=False,
+        transport=transport,
+    )
+
+
+def _is_loopback_endpoint(base_url: str) -> bool:
+    try:
+        parsed = urlsplit(base_url)
+        return parsed.scheme in {"http", "https"} and parsed.hostname in {
+            "127.0.0.1", "localhost", "::1"
+        }
+    except ValueError:
+        return False
+
+
+def _system_key(value: str) -> str:
+    return {
+        "FullContext": "fullcontext",
+        "OpenClaw": "openclaw",
+        "Mem0 OSS": "mem0",
+        "SimpleMem": "simplemem",
+        "PropMem": "propmem",
+    }.get(value, value)
+
+
+def reader_slot_context(config: ProviderConfig) -> int:
+    """Read llama.cpp slot metadata without proxy or non-loopback routing."""
+    parsed = urlsplit(config.reader_base_url)
+    base_path = parsed.path.removesuffix("/v1").rstrip("/")
+    url = urlunsplit((parsed.scheme, parsed.netloc, f"{base_path}/slots", "", ""))
+    with httpx.Client(timeout=15, trust_env=False) as client:
+        response = client.get(url)
+        response.raise_for_status()
+        slots = response.json()
+    if isinstance(slots, dict):
+        slots = [slots]
+    if not isinstance(slots, list) or not slots:
+        raise RuntimeError("Loopback llama.cpp /slots returned no active context metadata")
+    contexts = []
+    for slot in slots:
+        if isinstance(slot, dict):
+            value = slot.get("n_ctx", slot.get("n_ctx_slot", slot.get("context_length")))
+            if isinstance(value, int):
+                contexts.append(value)
+    if not contexts:
+        raise RuntimeError("Loopback llama.cpp /slots response has no context length")
+    return min(contexts)
+
+
+def measure_full_context_prompt(
+    messages: list[dict[str, Any]],
+    config: ProviderConfig,
+    *,
+    max_model_length: int,
+    output_reserve: int,
+) -> dict[str, int | bool]:
+    """Measure the exact llama.cpp chat-template prompt through loopback endpoints."""
+    url = config.reader_base_url.removesuffix("/v1")
+    with httpx.Client(timeout=120, trust_env=False) as client:
+        rendered = client.post(
+            f"{url}/apply-template",
+            json={
+                "messages": messages,
+                "add_generation_prompt": True,
+                "chat_template_kwargs": {"enable_thinking": False},
+            },
+        )
+        rendered.raise_for_status()
+        prompt = rendered.json().get("prompt")
+        if not isinstance(prompt, str):
+            raise RuntimeError("llama.cpp /apply-template did not return a rendered prompt")
+        tokenized = client.post(
+            f"{url}/tokenize",
+            json={"content": prompt, "add_special": False},
+        )
+        tokenized.raise_for_status()
+        tokens = tokenized.json().get("tokens")
+        if not isinstance(tokens, list):
+            raise RuntimeError("llama.cpp /tokenize did not return token IDs")
+    token_count = len(tokens)
+    _FULL_CONTEXT_EXPECTATION.set({
+        "prompt_tokens": token_count,
+        "max_model_length": max_model_length,
+        "output_reserve": output_reserve,
+    })
+    metrics = copy.deepcopy(_QUESTION_METRICS.get())
+    metrics.update({
+        "reader_prompt_tokens": token_count,
+        "full_context_max_model_length": max_model_length,
+        "full_context_tokenizer": "llama.cpp /apply-template + /tokenize",
+        "full_context_preflight_fits": full_context_fits(
+            token_count, max_model_length, output_reserve
+        ),
+    })
+    _QUESTION_METRICS.set(metrics)
+    return {
+        "prompt_tokens": token_count,
+        "max_model_length": max_model_length,
+        "output_reserve": output_reserve,
+        "truncated": not full_context_fits(token_count, max_model_length, output_reserve),
+    }
+
+
+def full_context_fits(
+    prompt_tokens: int,
+    max_model_length: int,
+    output_reserve: int,
+) -> bool:
+    if prompt_tokens < 0 or max_model_length < 1 or output_reserve < 1:
+        raise ValueError("FullContext token counts and limits must be positive")
+    return prompt_tokens + output_reserve <= max_model_length
+
+
+def validate_reader_model(config: ProviderConfig, requested_model: str) -> None:
+    if requested_model != config.reader_model:
+        raise RuntimeError(
+            f"Configured reader is {config.reader_model}; received {requested_model}"
+        )
+
+
+class _ReaderCompletions:
+    def __init__(self, raw: OpenAI, config: ProviderConfig, default_role: Role):
+        self._raw = raw
+        self._config = config
+        self._default_role = default_role
+
+    def create(self, **kwargs: Any) -> Any:
+        request = dict(kwargs)
+        request["model"] = self._config.reader_model
+        active_role = _CALL_CONTEXT.get().role or self._default_role
+        request["temperature"] = 0
+        request["seed"] = 42
+        if active_role == "reader_answer":
+            request.pop("max_completion_tokens", None)
+            request["max_tokens"] = self._config.reader_answer_max_new_tokens
+        else:
+            request.setdefault("max_tokens", 8192)
+        extra_body = request.get("extra_body")
+        extra_body = copy.deepcopy(extra_body) if isinstance(extra_body, dict) else {}
+        template_kwargs = extra_body.get("chat_template_kwargs", {})
+        template_kwargs["enable_thinking"] = False
+        extra_body["chat_template_kwargs"] = template_kwargs
+        request["extra_body"] = extra_body
+        if active_role == "reader_answer" and isinstance(request.get("messages"), list):
+            _READER_INPUT.set(copy.deepcopy(request["messages"]))
+        return self._raw.chat.completions.create(**request)
+
+
+class _ReaderClient:
+    def __init__(self, raw: OpenAI, config: ProviderConfig, default_role: Role):
+        self._raw = raw
+        self.chat = type(
+            "ChatProxy",
+            (),
+            {"completions": _ReaderCompletions(raw, config, default_role)},
+        )()
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._raw, name)
+
+
+def reader_client(
+    role: Literal["reader_answer", "memory_ingest", "memory_reasoning", "judge_local"],
+    system: str,
+    question_id: str,
+    config: ProviderConfig | None = None,
+) -> OpenAI:
+    config = config or ProviderConfig.from_env()
+    validate_reader_model(config, config.reader_model)
+    raw = OpenAI(
+        api_key=config.local_protocol_token,
+        base_url=config.reader_base_url,
+        timeout=httpx.Timeout(config.request_timeout_seconds, connect=10.0),
+        max_retries=config.max_retries,
+        http_client=_telemetry_client(role, system, question_id),
+    )
+    return _ReaderClient(raw, config, role)  # type: ignore[return-value]
+
+
+def embedding_client(system: str, question_id: str, config: ProviderConfig | None = None):
+    config = config or ProviderConfig.from_env()
+    from agents_memory.healthcopilot_embedding import LocalEmbeddingClient
+
+    return LocalEmbeddingClient(
+        model_path=config.embedding_path,
+        system=system,
+        question_id=question_id,
+        device=config.embedding_device,
+        dtype=config.embedding_dtype,
+    )
+
+
+def initialize_local_embedding(config: ProviderConfig):
+    from agents_memory.healthcopilot_embedding import get_local_embedding_runtime
+
+    return get_local_embedding_runtime(
+        config.embedding_path,
+        config.embedding_device,
+        config.embedding_dtype,
+    )
+
+
+def release_local_embedding_runtimes() -> None:
+    from agents_memory.healthcopilot_embedding import release_local_embedding_runtimes as release
+
+    release()
+
+
+def patch_openai_aliases(
+    package_prefix: str,
+    *,
+    role: Literal["memory_ingest", "memory_reasoning"],
+    system: str,
+    question_id: str,
+    config: ProviderConfig,
+) -> int:
+    """Replace already-imported third-party OpenAI aliases with the local reader."""
+    patched = 0
+
+    def factory(*_args: Any, **_kwargs: Any) -> OpenAI:
+        return reader_client(role, system, question_id, config)
+
+    for module in tuple(sys.modules.values()):
+        name = getattr(module, "__name__", "")
+        if not name.startswith(package_prefix):
+            continue
+        if getattr(module, "AsyncOpenAI", None) is AsyncOpenAI:
+            raise RuntimeError(f"Async OpenAI client in {name} needs an explicit local adapter")
+        if getattr(module, "OpenAI", None) is OpenAI:
+            setattr(module, "OpenAI", factory)
+            patched += 1
+    return patched
+
+
+def answer_request_kwargs(config: ProviderConfig, model: str | None = None, **kwargs: Any):
+    request = {"model": model or config.reader_model, **kwargs}
+    request["temperature"] = 0
+    request["seed"] = 42
+    request.pop("max_completion_tokens", None)
+    request.setdefault("max_tokens", config.reader_answer_max_new_tokens)
+    extra_body = request.get("extra_body")
+    extra_body = copy.deepcopy(extra_body) if isinstance(extra_body, dict) else {}
+    template_kwargs = extra_body.get("chat_template_kwargs", {})
+    template_kwargs["enable_thinking"] = False
+    extra_body["chat_template_kwargs"] = template_kwargs
+    request["extra_body"] = extra_body
+    return request
