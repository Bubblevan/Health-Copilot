+import asyncio
+
+import pytest
+
+from agents_memory import evaluation
+from agents_memory.healthcopilot_provider import ProviderConfig
+
+
+def test_infrastructure_failure_is_not_zero_quality_or_abstention():
+    from agents_memory.systems._helpers import _qa_results_async
+
+    async def fail(_question):
+        raise TimeoutError("local reader unavailable")
+
+    rows = asyncio.run(
+        _qa_results_async(
+            {
+                "sample_id": "q1",
+                "qa": [{
+                    "question_id": "q1",
+                    "question": "What did they choose?",
+                    "answer": "Swimming",
+                    "category": "knowledge-update",
+                }],
+            },
+            fail,
+            run_judge=False,
+            system_name="FullContext",
+        )
+    )
+
+    assert rows[0]["quality_status"] == "INFRA_FAILURE"
+    assert rows[0]["predicted"] is None
+    assert rows[0]["f1"] is None
+    assert "longmemeval_correct" not in rows[0]
+
+
+def test_legacy_llm_judge_is_explicitly_disabled():
+    with pytest.raises(RuntimeError, match="disabled by the MEM-1 local-only amendment"):
+        evaluation.evaluate_longmemeval(
+            "Question", "Expected", "Prediction", category="multi-session", question_id="q1"
+        )
+
+
+def test_main_local_provider_config_has_no_openai_secret_field():
+    config = ProviderConfig(
+        track="main_local_only",
+        reader_provider="local_qwen",
+        reader_base_url="http://127.0.0.1:8080/v1",
+        local_protocol_token="local-only",
+        reader_model="health-memory-qwen3-8b",
+        embedding_path="C:/frozen/qwen-embedding",
+    )
+    assert not hasattr(config, "openai_api_key")
+    assert not hasattr(config, "judge_model")
